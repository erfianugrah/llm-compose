# Accuracy harness for LLM benchmarks.
# Includes: EvalPlus (HumanEval+), lm-evaluation-harness (HellaSwag), BFCL (function calling).
# All evals target an OpenAI-compatible endpoint — point at the proxy or a bench llama-server.
FROM python:3.14-slim

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl jq build-essential \
    && rm -rf /var/lib/apt/lists/*

# Pinned versions — bump deliberately.
ARG EVALPLUS_VERSION=0.3.1
ARG LM_EVAL_VERSION=0.4.9
ARG BFCL_VERSION=2026.3.23

# Core deps
RUN pip install \
    "openai>=1.50,<2" \
    "tqdm>=4.66" \
    "datasets>=3.0,<4" \
    "transformers>=4.45,<5" \
    "huggingface_hub>=0.25"

# EvalPlus (HumanEval+, MBPP+) — runs sandboxed code execution.
RUN pip install "evalplus==${EVALPLUS_VERSION}"

# lm-evaluation-harness — HellaSwag, MMLU, ARC, GSM8K via local-completions / openai-completions.
RUN pip install "lm-eval[api]==${LM_EVAL_VERSION}"

# BFCL - Berkeley Function-Call Leaderboard. Installs `bfcl` CLI into its OWN
# venv: bfcl_eval's java_parser uses the legacy 2-arg tree_sitter.Language()
# constructor (needs core 0.21.x), while evalplus requires tree-sitter>=0.22.0
# - no single tree-sitter version satisfies both call conventions (verified
# 2026-08-17), so the two harnesses cannot share site-packages.
# bfcl-eval also pins faiss-cpu==1.11.0 which PyPI no longer carries (1.12+
# only, 2026-08): install with --no-deps + explicit deps with faiss relaxed.
# qwen_agent.utils.utils hard-imports soundfile but qwen-agent doesn't declare
# it as a hard dep.
RUN python -m venv /opt/venv-bfcl && \
    /opt/venv-bfcl/bin/pip install "bfcl-eval==${BFCL_VERSION}" --no-deps && \
    /opt/venv-bfcl/bin/pip install requests tqdm "numpy==1.26.4" pandas huggingface_hub \
      "pydantic>=2.8.2" "python-dotenv>=1.0.1" "tree_sitter==0.21.3" \
      "tree-sitter-java==0.21.0" "tree-sitter-javascript==0.21.4" \
      "openai>=1.86.0" "mistralai==1.7.0" "anthropic>=0.75.0" "cohere==5.18.0" \
      "typer>=0.12.5" "tabulate>=0.9.0" "datamodel-code-generator==0.25.7" \
      "google-genai>=1.52.0" qwen-agent soundfile "mpmath==1.3.0" "tenacity>=8.5.0" \
      "writer-sdk>=2.1.0" overrides boto3 beautifulsoup4 \
      "sentence-transformers>=2.7.0" "faiss-cpu>=1.12" && \
    ln -sf /opt/venv-bfcl/bin/bfcl /usr/local/bin/bfcl

WORKDIR /work
COPY run-evals.py /work/
COPY run-evals.sh /usr/local/bin/run-evals
RUN chmod +x /usr/local/bin/run-evals

ENTRYPOINT ["/usr/local/bin/run-evals"]
