# Accuracy harness for LLM benchmarks.
# Includes: EvalPlus (HumanEval+), lm-evaluation-harness (HellaSwag), BFCL (function calling).
# All evals target an OpenAI-compatible endpoint — point at the proxy or a bench llama-server.
FROM python:3.14-slim

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl jq build-essential \
    && rm -rf /var/lib/apt/lists/*

# Pinned versions — bump deliberately.
ARG EVALPLUS_VERSION=0.3.1
ARG LM_EVAL_VERSION=0.4.9
ARG BFCL_VERSION=2.0.0

# Core deps
RUN pip install \
    "openai>=1.50,<2" \
    "tqdm>=4.66" \
    "datasets>=3.0,<4" \
    "transformers>=4.45,<5" \
    "huggingface_hub>=0.25"

# EvalPlus (HumanEval+, MBPP+) — runs sandboxed code execution.
RUN pip install "evalplus==${EVALPLUS_VERSION}"

# lm-evaluation-harness — HellaSwag, MMLU, ARC, GSM8K via local-completions / openai-completions.
RUN pip install "lm-eval[api]==${LM_EVAL_VERSION}"

# BFCL — Berkeley Function-Call Leaderboard. Installs `bfcl` CLI.
RUN pip install "bfcl-eval==${BFCL_VERSION}" || \
    pip install "git+https://github.com/ShishirPatil/gorilla.git@main#subdirectory=berkeley-function-call-leaderboard"

WORKDIR /work
COPY run-evals.py /work/
COPY run-evals.sh /usr/local/bin/run-evals
RUN chmod +x /usr/local/bin/run-evals

ENTRYPOINT ["/usr/local/bin/run-evals"]
