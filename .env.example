# Model config — set automatically by `make switch MODEL=<name>` or by the proxy.
# You should not need to edit this file by hand. See models/*.env for presets.
#
# This example shows what `make switch MODEL=qwen35` would produce.
# The MMPROJ_FILE/TEMPLATE_FILE lines at the bottom are auto-derived from the
# preset name — don't set them in models/*.env presets.

VRAM_ESTIMATE_GB=18.0
MODEL_REPO=unsloth/Qwen3.5-27B-GGUF
MODEL_FILE=Qwen3.5-27B-Q4_K_M.gguf
MODEL_NAME=Qwen 3.5 27B Dense (local)
MMPROJ_URL=https://huggingface.co/unsloth/Qwen3.5-27B-GGUF/resolve/main/mmproj-BF16.gguf
TEMPLATE_URL=
REASONING=on
CONTEXT_SIZE=163840
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0
PRESENCE_PENALTY=1.5
REPEAT_PENALTY=1.0

# Auto-derived asset filenames (based on preset name)
MMPROJ_FILE=qwen35-mmproj.gguf
TEMPLATE_FILE=

# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=

# ── ComfyUI ──────────────────────────────────────────────────────────
# ComfyUI is managed by the proxy — no config needed here.
# The proxy auto-starts ComfyUI when requests hit /comfyui/* routes.
#
# Diffusion models go in:  ~/docker-volumes/comfyui/models/checkpoints/
# LoRAs:                   ~/docker-volumes/comfyui/models/loras/
# VAE:                     ~/docker-volumes/comfyui/models/vae/
# Generated output:        ~/docker-volumes/comfyui/output/
# Custom nodes:            ~/docker-volumes/comfyui/custom_nodes/
#
# ComfyUI web UI:  http://localhost:8188  (only when ComfyUI mode is active)
# Open WebUI integration: automatic via COMFYUI_BASE_URL in docker-compose.yml
