{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "comfyui": {
      "type": "local",
      "command": ["python3", "mcp/comfyui-server.py"],
      "environment": {
        "COMFYUI_PROXY_URL": "http://localhost:11434",
        "COMFYUI_OUTPUT_DIR": "~/docker-volumes/comfyui/output"
      },
      "enabled": true
    }
  }
}
