# Qwen 3.5 27B Dense — native multimodal (text + vision + video), thinking mode
# ~16.7 GB model + ~1.3 GB mmproj | 27B active params (dense)
# Best for: multimodal reasoning, coding with image context, general agentic work
VRAM_ESTIMATE_GB=18.0
MODEL_REPO=unsloth/Qwen3.5-27B-GGUF
MODEL_FILE=Qwen3.5-27B-Q4_K_M.gguf
MODEL_NAME=Qwen 3.5 27B Dense (local)
MMPROJ_URL=https://huggingface.co/unsloth/Qwen3.5-27B-GGUF/resolve/main/mmproj-BF16.gguf
TEMPLATE_URL=
REASONING=on
CONTEXT_SIZE=163840
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0
# presence_penalty=1.5 prevents Qwen3.5 repetition loops in general thinking mode
PRESENCE_PENALTY=1.5
REPEAT_PENALTY=1.0
