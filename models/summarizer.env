# Gemma 4 26B-A4B — MoE, 128K context, 4B active params
# ~17 GB model (Q4_K_M) | 26B total / 4B active per token
# Best for: TL;DW bot, accurate summarization, hallucination-resistant
# MoE = fast generation (only 4B active), 15GB headroom for KV cache
#
# 2 parallel slots × 65536 ctx each = 131072 total ctx.
# Sized for whisper-transcribe bot's 3-style fanout (brief/key_points/chapters).
# With 2 slots one style serialises behind another, but the gain of going 3→2
# is ~1.4 GB VRAM headroom — needed once the mmproj vision tower loads
# alongside the model. Q8 mmproj (770 MB) chosen over f16 (1.2 GB) for the
# same reason; quality loss is <1% on standard VLM benchmarks.
# 65536 per slot fits ~100k-char transcripts single-pass per style.
VRAM_ESTIMATE_GB=23
MODEL_REPO=ggml-org/gemma-4-26b-a4b-it-GGUF
MODEL_FILE=gemma-4-26B-A4B-it-Q4_K_M.gguf
MODEL_NAME=Gemma 4 26B-A4B — 128K context, accurate MoE summarization
MMPROJ_URL=
# Vision tower for gemma-4-26B-A4B-it. Lets the same model serve both
# text summarization AND image input (frame descriptions for the VLM
# pipeline in whisper-transcribe). Without this, image requests get
# rejected with "image input is not supported" from llama-server.
# File lives in /models (single source of truth; see DOCKER_VOLUMES_DIR
# in root .env). Pulled from the same HF repo as the main gguf.
MMPROJ_FILE=mmproj-gemma-4-26B-A4B-it-Q8_0.gguf
TEMPLATE_URL=
REASONING=off
CONTEXT_SIZE=131072
PARALLEL_SLOTS=2
TEMPERATURE=0.3
TOP_P=0.9
TOP_K=40
MIN_P=0
PRESENCE_PENALTY=0
REPEAT_PENALTY=1.0
