MODEL_NAME=Gemma 4 26B-A4B — 128K context, accurate MoE summarization
MMPROJ_URL=
TEMPLATE_URL=
REASONING=off
CONTEXT_SIZE=32768
TEMPERATURE=0.3
TOP_P=0.9
TOP_K=40
MIN_P=0
PRESENCE_PENALTY=0
REPEAT_PENALTY=1.0
