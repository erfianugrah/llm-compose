# Gemma 4 26B-A4B — MoE, 128K context, 4B active params
# ~17 GB model (Q4_K_M) | 26B total / 4B active per token
# Best for: TL;DW bot, accurate summarization, hallucination-resistant
# MoE = fast generation (only 4B active), 15GB headroom for KV cache
#
# Unified text + vision endpoint. Single process serves both modalities:
# - Text summarization (bot's brief/key_points/chapters)
# - Image input for /api/describe frame descriptions (Q8 mmproj loaded)
#
# Why single-service over the dual-llama-server experiment:
# - One CUDA context, one cublas workspace, one kernel cache — pooled
#   across both modalities. Dual-service duplicates all of this and
#   pushes total static footprint past 32 GB on a 5090.
# - mmproj weights cost ~770 MB (Q8) on top of the 17 GB main model;
#   shared CUDA context absorbs this without doubling overhead.
# - The "state leakage between text/vision modes" is a real but small
#   cost, dominated by the savings from single CUDA context.
#
# 2 slots × 65536 ctx = 131072 total. Two slots fit the bot's
# brief/key_points/chapters fanout with partial parallelism. -b/-ub 2048
# keeps the compute buffer at ~2 GB instead of ~4 GB; minor prompt-
# processing slowdown but huge headroom win.
VRAM_ESTIMATE_GB=24
MODEL_REPO=ggml-org/gemma-4-26b-a4b-it-GGUF
MODEL_FILE=gemma-4-26B-A4B-it-Q4_K_M.gguf
MODEL_NAME=Gemma 4 26B-A4B — 128K context, accurate MoE summarization
MMPROJ_URL=
# Vision tower co-resident with the main model. Q8 chosen over f16 to
# save ~500 MB VRAM with <1% quality loss on VLM benchmarks.
MMPROJ_FILE=mmproj-gemma-4-26B-A4B-it-Q8_0.gguf
TEMPLATE_URL=
REASONING=off
CONTEXT_SIZE=131072
PARALLEL_SLOTS=2
TEMPERATURE=0.3
TOP_P=0.9
TOP_K=40
MIN_P=0
PRESENCE_PENALTY=0
REPEAT_PENALTY=1.0
