# Gemma 4 26B-A4B — MoE, 128K context, 4B active params
# ~17 GB model (Q4_K_M) | 26B total / 4B active per token
# Best for: TL;DW bot, accurate summarization, hallucination-resistant
# MoE = fast generation (only 4B active), 15GB headroom for KV cache
VRAM_ESTIMATE_GB=18
MODEL_REPO=ggml-org/gemma-4-26b-a4b-it-GGUF
