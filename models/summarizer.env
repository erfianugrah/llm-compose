# Qwen3.5-4B — 262K native context, hybrid GatedDeltaNet+Attention
# ~4.5 GB model (Q8_0) | 4B params (dense) | 262K context native
# Best for: TL;DW bot, long transcript summarization, document condensation
# KV cache is tiny due to 3:1 DeltaNet:Attention ratio (only 1/4 layers need full KV)
VRAM_ESTIMATE_GB=5
MODEL_REPO=unsloth/Qwen3.5-4B-GGUF
MODEL_FILE=Qwen3.5-4B-Q8_0.gguf
MODEL_NAME=Qwen3.5 4B — 262K context, fast summarization
MMPROJ_URL=
TEMPLATE_URL=
REASONING=off
CONTEXT_SIZE=262144
TEMPERATURE=0.3
TOP_P=0.9
TOP_K=40
MIN_P=0
PRESENCE_PENALTY=0
REPEAT_PENALTY=1.0
