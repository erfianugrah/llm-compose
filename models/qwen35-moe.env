# Qwen 3.5 35B-A3B MoE — fast MoE inference, thinking mode, text-only
# ~20.7 GB model (Q4_K_S) | ~3B active params per token
# Best for: fast coding iteration, reasoning, agentic tasks (no vision to fit VRAM)
VRAM_ESTIMATE_GB=20.7
MODEL_REPO=unsloth/Qwen3.5-35B-A3B-GGUF
MODEL_FILE=Qwen3.5-35B-A3B-Q4_K_S.gguf
MODEL_NAME=Qwen 3.5 35B MoE (local)
MMPROJ_FILE=
MMPROJ_URL=
TEMPLATE_FILE=
TEMPLATE_URL=
REASONING=on
CONTEXT_SIZE=65536
TEMPERATURE=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0
