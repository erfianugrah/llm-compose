# Qwen3.6 27B Dense — flagship coding, thinking mode, vision support
# ~16.4 GB model (UD-Q4_K_XL) + ~0.9 GB mmproj | 27B dense params
# Best for: agentic coding (SWE-bench 77.2), frontend workflows, repo-level reasoning
# Released 2026-04-22 — outperforms Qwen3.6-35B-A3B on coding benchmarks
VRAM_ESTIMATE_GB=17.5
MODEL_REPO=unsloth/Qwen3.6-27B-GGUF
MODEL_FILE=Qwen3.6-27B-UD-Q4_K_XL.gguf
MODEL_NAME=Qwen3.6 27B Dense (local)
MMPROJ_URL=https://huggingface.co/unsloth/Qwen3.6-27B-GGUF/resolve/main/mmproj-BF16.gguf
TEMPLATE_URL=
REASONING=on
CONTEXT_SIZE=163840
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0
# Qwen3.6-27B Dense is more stable than the MoE variant — card recommends
# presence_penalty=0.0 for thinking mode. If you see repetition loops,
# bump to 1.5 (the card allows 0-2 range).
PRESENCE_PENALTY=0.0
REPEAT_PENALTY=1.0
