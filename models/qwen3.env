# Qwen3 32B — dense general-purpose, thinking mode, strong tool calling
# ~20 GB model (Q4_K_M) | 32B active params (dense)
# Best for: research, science, daily questions, web search, tool use, reasoning
VRAM_ESTIMATE_GB=20
MODEL_REPO=ggml-org/Qwen3-32B-GGUF
MODEL_FILE=Qwen3-32B-Q4_K_M.gguf
MODEL_NAME=Qwen3 32B Dense — reasoning, tools, thinking
MMPROJ_URL=
TEMPLATE_URL=
REASONING=on
CONTEXT_SIZE=40960
TEMPERATURE=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0
# presence_penalty=1.5 prevents Qwen3 repetition loops
PRESENCE_PENALTY=1.5
REPEAT_PENALTY=1.0
