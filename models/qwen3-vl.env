# Qwen3-VL 2B Instruct — small, fast vision-language model dedicated for
# image/video frame description.
# ~1.6 GB model (Q8_0) + ~1.4 GB mmproj | 2B params, 262k native context
# Best for: frame-level video description (whisper-transcribe /api/describe),
# image captioning, simple OCR. Tiny VRAM footprint coexists with the LLM
# hot-swap and leaves headroom for ComfyUI / training jobs.
#
# Used by the whisper-transcribe bot's VLM fallback for silent / sparse-speech
# videos (set LLM_VISION_MODEL=Qwen3-VL-2B-Instruct-Q8_0 in bot/.env).
# Q8 quant on a 2B model is effectively lossless for description tasks; no
# need for Q4 here.
VRAM_ESTIMATE_GB=4.5
MODEL_REPO=ggml-org/Qwen3-VL-2B-Instruct-GGUF
MODEL_FILE=Qwen3-VL-2B-Instruct-Q8_0.gguf
MODEL_NAME=Qwen3-VL 2B — vision, image/video description
MMPROJ_URL=https://huggingface.co/ggml-org/Qwen3-VL-2B-Instruct-GGUF/resolve/main/mmproj-Qwen3-VL-2B-Instruct-Q8_0.gguf
TEMPLATE_URL=
REASONING=
# 32k is plenty for one image + the description prompt; saves KV cache vs.
# the 262k native context.
CONTEXT_SIZE=32768
TEMPERATURE=0.3
TOP_P=0.95
TOP_K=20
MIN_P=0.05
