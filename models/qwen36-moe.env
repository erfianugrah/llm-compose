# Qwen3.6 35B-A3B MoE — agentic coding, thinking mode, vision support
# ~22.1 GB model (UD-Q4_K_M) | ~3B active params per token
# Best for: agentic coding, frontend workflows, repo-level reasoning, tool use
VRAM_ESTIMATE_GB=22.0
MODEL_REPO=unsloth/Qwen3.6-35B-A3B-GGUF
MODEL_FILE=Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
MODEL_NAME=Qwen3.6 35B MoE — coding, vision, thinking, fast
MMPROJ_URL=https://huggingface.co/unsloth/Qwen3.6-35B-A3B-GGUF/resolve/main/mmproj-BF16.gguf
TEMPLATE_URL=
REASONING=on
CONTEXT_SIZE=163840
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0
# presence_penalty=1.5 is Qwen3.6 recommended value for general thinking mode —
# required to prevent degenerate repetition loops (see model card).
PRESENCE_PENALTY=1.5
REPEAT_PENALTY=1.0
